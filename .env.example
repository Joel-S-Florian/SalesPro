# Database
DATABASE_URL="postgresql://salespro:password@localhost:5432/salespro?schema=public"

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="your-super-secret-jwt-access-token-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-token-key-min-32-chars"

# Token Expiry
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Bcrypt
BCRYPT_ROUNDS=12

# Server
NODE_ENV="development"
PORT=4010

# CORS
CORS_ORIGIN="http://localhost:5180,http://localhost:5190"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# GEMINI API (existing) 
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:4010"
# Facturación electrónica (DGII)
# Llave de 32 bytes en base64 para cifrar certificados: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ECF_MASTER_KEY=""
# Apunta TODO el e-CF a un simulador (node scripts/dgii-sim.mjs). Dejar vacío en producción.
ECF_BASE_URL_OVERRIDE=""
# Dirección pública del API (para registrar las URL de recepción ante la DGII)
PUBLIC_API_URL=""
