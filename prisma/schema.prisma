generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id               String                @id @default(cuid())
  name             String
  rnc              String?               @unique
  email            String?
  phone            String?
  address          String?
  active           Boolean               @default(true)
  plan             PlanType              @default(STARTER)
  trialEndsAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  users            User[]
  categories       Category[]
  products         Product[]
  customers        Customer[]
  sales            Sale[]
  saleDetails      SaleDetail[]
  inventoryLogs    InventoryLog[]
  suppliers        Supplier[]
  configs          SystemConfig[]
  terminals        Terminal[]
  cashierCloses    CashierClose[]
  imports          InventoryImport[]
  ncfSequences     NCFSequence[]
  auditLogs        AuditLog[]
  ecfConfig        EcfConfig?
  ecfSequences     EcfSequence[]
  ecfDocuments     EcfDocument[]
  ecfInbox         EcfInbox[]
  productBatches   ProductBatch[]
  saleBatchDetails SaleBatchDetail[]
  presentations    ProductPresentation[]

  @@map("companies")
}

model Lead {
  id           String     @id @default(cuid())
  name         String
  business     String
  businessType String?
  contact      String
  note         String?
  status       LeadStatus @default(NEW)
  companyId    String? // empresa creada al aprobar la solicitud
  ipAddress    String?
  createdAt    DateTime   @default(now())
  handledAt    DateTime?

  @@index([status, createdAt])
  @@map("leads")
}

enum LeadStatus {
  NEW
  APPROVED
  REJECTED
}

enum PlanType {
  FREE
  STARTER
  BUSINESS
  PRO
  ENTERPRISE
}

model User {
  id                String         @id @default(cuid())
  username          String         @unique
  passwordHash      String
  fullName          String
  role              UserRole       @default(VENDEDOR)
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  auditLogs         AuditLog[]
  inventoryLogs     InventoryLog[]
  sales             Sale[]         @relation("SaleUser")
  sessions          Session[]
  terminals         Terminal[]     @relation("TerminalUsers")
  defaultTerminalId String?
  defaultTerminal   Terminal?      @relation("DefaultTerminal", fields: [defaultTerminalId], references: [id])
  cashierCloses     CashierClose[] @relation("CloseCashier")
  companyId         String?
  company           Company?       @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@index([companyId])
  @@map("categories")
}

model Product {
  id            String                @id @default(cuid())
  code          String
  name          String
  description   String?
  categoryId    String
  costPrice     Float
  salePrice     Float
  stock         Float                 @default(0) // en la unidad base del producto (2 decimales en productos a granel)
  minStock      Float                 @default(0)
  unit          String                @default("UND") // UND, LB, KG, OZ, GR, LT, GAL... (ver shared/utils/units.js)
  presentations ProductPresentation[]
  active        Boolean               @default(true)
  isPerishable  Boolean               @default(false)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  inventoryLogs InventoryLog[]
  batches       ProductBatch[]
  category      Category              @relation(fields: [categoryId], references: [id])
  saleDetails   SaleDetail[]
  companyId     String
  company       Company               @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId])
  @@map("products")
}

model Customer {
  id                    String    @id @default(cuid())
  documentId            String
  name                  String
  email                 String?
  phone                 String?
  address               String?
  rnc                   String?
  ecfIssuer             Boolean? // ¿es emisor electrónico? (directorio DGII)
  ecfReceptionUrl       String?
  ecfApprovalUrl        String?
  ecfDirectoryCheckedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  sales                 Sale[]
  companyId             String
  company               Company   @relation(fields: [companyId], references: [id])

  @@unique([companyId, documentId])
  @@index([companyId])
  @@map("customers")
}

model Sale {
  id              String        @id @default(cuid())
  invoiceNumber   String
  ncfType         NCFType       @default(B02)
  customerId      String
  customerName    String
  userId          String
  userName        String
  subtotal        Float
  tax             Float
  discount        Float         @default(0)
  total           Float
  paymentMethod   PaymentMethod
  notes           String?
  relatedSaleId   String? // nota de crédito -> venta original
  ecfType         EcfType?
  eNcf            String?
  ecfStatus       EcfStatus?
  ecfTrackId      String?
  ecfSecurityCode String?
  ecfSignedAt     DateTime?
  ecfStampUrl     String? // enlace del QR (timbre) de la representación impresa
  ecfDocuments    EcfDocument[]
  createdAt       DateTime      @default(now())
  terminalId      String?
  cashierCloseId  String?
  details         SaleDetail[]
  terminal        Terminal?     @relation(fields: [terminalId], references: [id])
  cashierClose    CashierClose? @relation(fields: [cashierCloseId], references: [id])
  customer        Customer      @relation(fields: [customerId], references: [id])
  user            User          @relation("SaleUser", fields: [userId], references: [id])
  relatedSale     Sale?         @relation("CreditNotes", fields: [relatedSaleId], references: [id])
  creditNotes     Sale[]        @relation("CreditNotes")
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])

  @@unique([companyId, invoiceNumber])
  @@unique([companyId, eNcf])
  @@index([companyId])
  @@index([relatedSaleId])
  @@map("sales")
}

model SaleDetail {
  id               String            @id @default(cuid())
  saleId           String
  productId        String
  productName      String
  quantity         Float // siempre en la unidad base del producto (negativa en notas de crédito)
  unit             String            @default("UND")
  presentationName String? // "Paquete x12": cómo se vendió (informativo; quantity ya está en unidades base)
  presentationQty  Float? // 2 -> "2 paquetes"
  unitPrice        Float
  unitCost         Float             @default(0)
  discount         Float             @default(0)
  subtotal         Float
  product          Product           @relation(fields: [productId], references: [id])
  sale             Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id])
  batches          SaleBatchDetail[]

  @@index([companyId])
  @@map("sale_details")
}

model InventoryLog {
  id            String        @id @default(cuid())
  productId     String
  productName   String
  type          InventoryType
  quantity      Float
  reason        String
  userId        String
  userName      String
  unitCost      Float?
  totalCost     Float?
  supplier      String?
  supplierId    String?
  invoiceNumber String?
  createdAt     DateTime      @default(now())
  product       Product       @relation(fields: [productId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  supplierRef   Supplier?     @relation(fields: [supplierId], references: [id])
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("inventory_logs")
}

model Supplier {
  id           String         @id @default(cuid())
  name         String
  rnc          String?
  contactName  String?
  email        String?
  phone        String?
  address      String?
  paymentTerms String?
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  purchases    InventoryLog[]
  batches      ProductBatch[]
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id])

  @@unique([companyId, rnc])
  @@index([companyId])
  @@map("suppliers")
}

/// Presentación de venta de un producto: Paquete x12, Caja x24... Vender una presentación descuenta
/// `factor` unidades base del mismo stock (y del mismo lote, FEFO). Puede tener su propio código de barras.
model ProductPresentation {
  id        String   @id @default(cuid())
  productId String
  name      String
  factor    Float // unidades base que contiene
  salePrice Float // precio de la presentación completa
  barcode   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, productId, name])
  @@unique([companyId, barcode])
  @@index([companyId, productId])
  @@map("product_presentations")
}

/// Lote de un producto perecedero. Product.stock = suma de currentStock de sus lotes.
/// expirationDate nulo = lote genérico (SIN-LOTE): se vende al final (FEFO) y no genera alertas.
model ProductBatch {
  id             String            @id @default(cuid())
  productId      String
  batchNumber    String
  expirationDate DateTime?
  initialStock   Float
  currentStock   Float
  costPrice      Float             @default(0)
  supplierId     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier       Supplier?         @relation(fields: [supplierId], references: [id])
  saleDetails    SaleBatchDetail[]
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id])

  @@unique([companyId, productId, batchNumber])
  @@index([companyId, productId])
  @@index([companyId, expirationDate])
  @@map("product_batches")
}

/// Qué lote(s) se descontaron en cada línea de venta (trazabilidad y devoluciones).
model SaleBatchDetail {
  id             String       @id @default(cuid())
  saleDetailId   String
  batchId        String
  quantity       Float
  discountAmount Float        @default(0) // descuento por vencimiento dado a esta porción
  saleDetail     SaleDetail   @relation(fields: [saleDetailId], references: [id], onDelete: Cascade)
  batch          ProductBatch @relation(fields: [batchId], references: [id])
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])

  @@index([companyId, saleDetailId])
  @@index([batchId])
  @@map("sale_batch_details")
}

model SystemConfig {
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  @@id([companyId, key])
  @@map("system_config")
}

model Terminal {
  id            String         @id @default(cuid())
  name          String
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]         @relation("TerminalUsers")
  defaultFor    User[]         @relation("DefaultTerminal")
  sales         Sale[]
  cashierCloses CashierClose[]
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@index([companyId])
  @@map("terminals")
}

model CashierClose {
  id             String      @id @default(cuid())
  terminalId     String
  userId         String
  openedAt       DateTime    @default(now())
  closedAt       DateTime?
  openingBalance Float       @default(0)
  expectedCash   Float?
  declaredCash   Float?
  difference     Float?
  status         CloseStatus @default(OPEN)
  notes          String?
  summary        Json?
  terminal       Terminal    @relation(fields: [terminalId], references: [id])
  user           User        @relation("CloseCashier", fields: [userId], references: [id])
  sales          Sale[]
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("cashier_closes")
}

enum CloseStatus {
  OPEN
  CLOSED
}

model InventoryImport {
  id         String               @id @default(cuid())
  fileName   String
  status     ImportStatus         @default(STAGED)
  userId     String
  userName   String
  supplierId String?
  mapping    Json?
  options    Json?
  summary    Json?
  createdAt  DateTime             @default(now())
  appliedAt  DateTime?
  rows       InventoryImportRow[]
  companyId  String
  company    Company              @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("inventory_imports")
}

model InventoryImportRow {
  id        String           @id @default(cuid())
  importId  String
  rowNumber Int
  raw       Json // fila original sin modificar (auditoría)
  data      Json? // fila sanitizada y normalizada
  action    ImportRowAction?
  errors    Json?
  import    InventoryImport  @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@map("inventory_import_rows")
}

enum ImportStatus {
  STAGED
  APPLIED
  CANCELED
}

enum ImportRowAction {
  CREATE
  UPDATE
  INVALID
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("audit_logs")
}

model NCFSequence {
  id        String   @id @default(cuid())
  ncfType   NCFType
  prefix    String
  current   Int      @default(0)
  max       Int      @default(99999999)
  updatedAt DateTime @updatedAt
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, ncfType])
  @@index([companyId])
  @@map("ncf_sequences")
}

enum UserRole {
  SUPERADMIN
  ADMINISTRADOR
  VENDEDOR
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
}

enum InventoryType {
  ENTRADA
  SALIDA
  AJUSTE
  DEVOLUCION
  MERMA // baja por vencimiento, daño o pérdida (con costo perdido)
}

enum NCFType {
  B01
  B02
  B03
  B04
  B05
  B06
  B07
  B08
  B09
  B10
  B11
  B12
  B13
  B14
  B15
  B16
}

// ---------------------------------------------------------------------------
// Facturación electrónica (e-CF, DGII)
// ---------------------------------------------------------------------------

enum EcfMode {
  OFF // solo comprobantes de papel (serie B)
  PRECERT // ambiente de pre-certificación (testecf)
  CERT // ambiente de certificación (certecf)
  PROD // producción (ecf): validez fiscal
}

enum EcfType {
  E31 // Factura de crédito fiscal
  E32 // Factura de consumo
  E33 // Nota de débito
  E34 // Nota de crédito
  E41 // Comprobante de compras
  E43 // Gastos menores
  E44 // Regímenes especiales
  E45 // Gubernamental
  E46 // Exportaciones
  E47 // Pagos al exterior
}

/// Configuración de facturación electrónica de una empresa. El certificado y su contraseña se guardan cifrados (AES-256-GCM).
model EcfConfig {
  id                 String    @id @default(cuid())
  companyId          String    @unique
  company            Company   @relation(fields: [companyId], references: [id])
  mode               EcfMode   @default(OFF)
  legalName          String?
  tradeName          String?
  address            String?
  municipalityCode   String?
  provinceCode       String?
  economicActivity   String?
  certificateEnc     String?   @db.Text
  certificatePassEnc String?   @db.Text
  keyVersion         Int       @default(1)
  certSubject        String?
  certSerial         String?
  certIssuer         String?
  certNotBefore      DateTime?
  certNotAfter       DateTime?
  certFingerprint    String?
  certRncMatch       Boolean?
  lastConnectionAt   DateTime?
  lastConnectionOk   Boolean?
  lastConnectionNote String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("ecf_configs")
}

/// Rango de e-NCF autorizado por la DGII para un tipo de comprobante.
model EcfSequence {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  ecfType    EcfType
  rangeFrom  Int       @default(1)
  rangeTo    Int
  current    Int       @default(0) // último número usado
  validUntil DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([companyId, ecfType, rangeFrom])
  @@index([companyId])
  @@map("ecf_sequences")
}

enum EcfStatus {
  PENDING // firmado, aún sin enviar
  SENT // enviado, esperando resultado
  ACCEPTED
  CONDITIONAL // aceptado condicional (válido)
  REJECTED
  ERROR // error de envío; se reintenta
  CONTINGENCY // no se pudo enviar a tiempo
  STORED // guardado localmente; no se envía por sí mismo (E32 < RD$250,000: se informa con su resumen RFCE)
}

enum EcfDocKind {
  ECF
  RFCE // resumen de factura de consumo < RD$250,000
  ARECF // acuse de recibo
  ACECF // aprobación comercial
  ANULACION // anulación de rangos de e-NCF
  DELIVERY // copia del e-CF aceptado, enviada al comprador cuando también es emisor electrónico
}

/// Documento electrónico firmado y su ciclo de envío a la DGII (también funciona como cola con reintentos).
model EcfDocument {
  id            String     @id @default(cuid())
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id])
  saleId        String?
  sale          Sale?      @relation(fields: [saleId], references: [id])
  kind          EcfDocKind
  eNcf          String?
  xml           String     @db.Text
  status        EcfStatus  @default(PENDING)
  trackId       String?
  dgiiCode      Int?
  dgiiMessages  Json?
  attempts      Int        @default(0)
  nextAttemptAt DateTime?
  target        String? // destino de una entrega (URL del comprador)
  lastError     String?    @db.Text
  sentAt        DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([saleId, kind])
  @@index([companyId, status, nextAttemptAt])
  @@index([saleId])
  @@map("ecf_documents")
}

/// e-CF recibidos de otros emisores (la empresa actúa como receptor electrónico).
model EcfInbox {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  rncEmisor  String
  eNcf       String
  total      Float?
  xml        String   @db.Text
  arecfXml   String?  @db.Text
  status     String   @default("RECIBIDO")
  receivedAt DateTime @default(now())

  @@unique([companyId, rncEmisor, eNcf])
  @@index([companyId])
  @@map("ecf_inbox")
}
