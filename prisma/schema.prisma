generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  passwordHash  String
  fullName      String
  role          UserRole       @default(VENDEDOR)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  auditLogs     AuditLog[]
  inventoryLogs InventoryLog[]
  sales         Sale[]         @relation("SaleUser")
  sessions      Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  description   String?
  categoryId    String
  costPrice     Float
  salePrice     Float
  stock         Int            @default(0)
  minStock      Int            @default(0)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  inventoryLogs InventoryLog[]
  category      Category       @relation(fields: [categoryId], references: [id])
  saleDetails   SaleDetail[]

  @@map("products")
}

model Customer {
  id         String   @id @default(cuid())
  documentId String   @unique
  name       String
  email      String?
  phone      String?
  address    String?
  rnc        String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  sales      Sale[]

  @@map("customers")
}

model Sale {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  ncfType       NCFType       @default(B01)
  customerId    String
  customerName  String
  userId        String
  userName      String
  subtotal      Float
  tax           Float
  discount      Float         @default(0)
  total         Float
  paymentMethod PaymentMethod
  notes         String?
  createdAt     DateTime      @default(now())
  details       SaleDetail[]
  customer      Customer      @relation(fields: [customerId], references: [id])
  user          User          @relation("SaleUser", fields: [userId], references: [id])

  @@map("sales")
}

model SaleDetail {
  id          String  @id @default(cuid())
  saleId      String
  productId   String
  productName String
  quantity    Int
  unitPrice   Float
  discount    Float   @default(0)
  subtotal    Float
  product     Product @relation(fields: [productId], references: [id])
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_details")
}

model InventoryLog {
  id          String        @id @default(cuid())
  productId   String
  productName String
  type        InventoryType
  quantity    Int
  reason      String
  userId      String
  userName    String
  unitCost    Float?
  totalCost   Float?
  supplier    String?
  invoiceNumber String?
  createdAt   DateTime      @default(now())
  product     Product       @relation(fields: [productId], references: [id])
  user        User          @relation(fields: [userId], references: [id])

  @@map("inventory_logs")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model NCFSequence {
  id        String   @id @default(cuid())
  ncfType   NCFType  @unique
  prefix    String
  current   Int      @default(0)
  max       Int      @default(99999999)
  updatedAt DateTime @updatedAt

  @@map("ncf_sequences")
}

enum UserRole {
  ADMINISTRADOR
  VENDEDOR
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
}

enum InventoryType {
  ENTRADA
  SALIDA
  AJUSTE
  DEVOLUCION
}

enum NCFType {
  B01
  B02
  B03
  B04
  B05
  B06
  B07
  B08
  B09
  B10
  B11
  B12
  B13
  B14
  B15
  B16
}
