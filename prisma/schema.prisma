generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(cuid())
  username          String         @unique
  passwordHash      String
  fullName          String
  role              UserRole       @default(VENDEDOR)
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  auditLogs         AuditLog[]
  inventoryLogs     InventoryLog[]
  sales             Sale[]         @relation("SaleUser")
  sessions          Session[]
  terminals         Terminal[]     @relation("TerminalUsers")
  defaultTerminalId String?
  defaultTerminal   Terminal?      @relation("DefaultTerminal", fields: [defaultTerminalId], references: [id])
  cashierCloses     CashierClose[] @relation("CloseCashier")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  description   String?
  categoryId    String
  costPrice     Float
  salePrice     Float
  stock         Int            @default(0)
  minStock      Int            @default(0)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  inventoryLogs InventoryLog[]
  category      Category       @relation(fields: [categoryId], references: [id])
  saleDetails   SaleDetail[]

  @@map("products")
}

model Customer {
  id         String   @id @default(cuid())
  documentId String   @unique
  name       String
  email      String?
  phone      String?
  address    String?
  rnc        String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  sales      Sale[]

  @@map("customers")
}

model Sale {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  ncfType        NCFType       @default(B01)
  customerId     String
  customerName   String
  userId         String
  userName       String
  subtotal       Float
  tax            Float
  discount       Float         @default(0)
  total          Float
  paymentMethod  PaymentMethod
  notes          String?
  createdAt      DateTime      @default(now())
  terminalId     String?
  cashierCloseId String?
  details        SaleDetail[]
  terminal       Terminal?     @relation(fields: [terminalId], references: [id])
  cashierClose   CashierClose? @relation(fields: [cashierCloseId], references: [id])
  customer       Customer      @relation(fields: [customerId], references: [id])
  user           User          @relation("SaleUser", fields: [userId], references: [id])

  @@map("sales")
}

model SaleDetail {
  id          String  @id @default(cuid())
  saleId      String
  productId   String
  productName String
  quantity    Int
  unitPrice   Float
  unitCost    Float   @default(0)
  discount    Float   @default(0)
  subtotal    Float
  product     Product @relation(fields: [productId], references: [id])
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_details")
}

model InventoryLog {
  id            String        @id @default(cuid())
  productId     String
  productName   String
  type          InventoryType
  quantity      Int
  reason        String
  userId        String
  userName      String
  unitCost      Float?
  totalCost     Float?
  supplier      String?
  supplierId    String?
  invoiceNumber String?
  createdAt     DateTime      @default(now())
  product       Product       @relation(fields: [productId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  supplierRef   Supplier?     @relation(fields: [supplierId], references: [id])

  @@map("inventory_logs")
}

model Supplier {
  id           String         @id @default(cuid())
  name         String
  rnc          String?        @unique
  contactName  String?
  email        String?
  phone        String?
  address      String?
  paymentTerms String?
  active       Boolean        @default(true)
  companyId    String? // reservado para multi-cliente
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  purchases    InventoryLog[]

  @@map("suppliers")
}

model SystemConfig {
  key       String   @id
  value     Json
  companyId String? // reservado para multi-cliente
  updatedAt DateTime @updatedAt

  @@map("system_config")
}

model Terminal {
  id            String         @id @default(cuid())
  name          String         @unique
  active        Boolean        @default(true)
  companyId     String? // reservado para multi-cliente
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]         @relation("TerminalUsers")
  defaultFor    User[]         @relation("DefaultTerminal")
  sales         Sale[]
  cashierCloses CashierClose[]

  @@map("terminals")
}

model CashierClose {
  id             String      @id @default(cuid())
  terminalId     String
  userId         String
  openedAt       DateTime    @default(now())
  closedAt       DateTime?
  openingBalance Float       @default(0)
  expectedCash   Float?
  declaredCash   Float?
  difference     Float?
  status         CloseStatus @default(OPEN)
  notes          String?
  summary        Json?
  terminal       Terminal    @relation(fields: [terminalId], references: [id])
  user           User        @relation("CloseCashier", fields: [userId], references: [id])
  sales          Sale[]

  @@map("cashier_closes")
}

enum CloseStatus {
  OPEN
  CLOSED
}

model InventoryImport {
  id         String               @id @default(cuid())
  fileName   String
  status     ImportStatus         @default(STAGED)
  userId     String
  userName   String
  supplierId String?
  mapping    Json?
  options    Json?
  summary    Json?
  companyId  String? // reservado para multi-cliente
  createdAt  DateTime             @default(now())
  appliedAt  DateTime?
  rows       InventoryImportRow[]

  @@map("inventory_imports")
}

model InventoryImportRow {
  id        String           @id @default(cuid())
  importId  String
  rowNumber Int
  raw       Json // fila original sin modificar (auditoría)
  data      Json? // fila sanitizada y normalizada
  action    ImportRowAction?
  errors    Json?
  import    InventoryImport  @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@map("inventory_import_rows")
}

enum ImportStatus {
  STAGED
  APPLIED
  CANCELED
}

enum ImportRowAction {
  CREATE
  UPDATE
  INVALID
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model NCFSequence {
  id        String   @id @default(cuid())
  ncfType   NCFType  @unique
  prefix    String
  current   Int      @default(0)
  max       Int      @default(99999999)
  updatedAt DateTime @updatedAt

  @@map("ncf_sequences")
}

enum UserRole {
  ADMINISTRADOR
  VENDEDOR
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
}

enum InventoryType {
  ENTRADA
  SALIDA
  AJUSTE
  DEVOLUCION
}

enum NCFType {
  B01
  B02
  B03
  B04
  B05
  B06
  B07
  B08
  B09
  B10
  B11
  B12
  B13
  B14
  B15
  B16
}
